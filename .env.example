# Copy to .env and fill in. .env is gitignored.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-5
EMBED_MODEL=text-embedding-3-small

# Path to the fine-tuned router model. Leave unset for the default
# (resolves to <repo>/router/model regardless of cwd). Override with an
# ABSOLUTE path if you want to load a model from elsewhere.
# ROUTER_MODEL_PATH=/absolute/path/to/model
